# Render provides PORT automatically. This is for local testing only.
PORT=10000

# Existing MADNI LPG Cloudflare Worker. Do not replace it with the Socket.IO URL.
MADNI_WORKER_URL=https://madni-lpg-api.nebulaelectronicsshop.workers.dev

# Add your POS web origin exactly. Include null only while testing the standalone file via file://.
# Example: null,http://localhost:3000,https://your-pos-domain.example
ALLOWED_ORIGINS=null,http://localhost:3000

# Recommended false. Only set true temporarily if the old Worker does not return shop_owner_id;
# this permits a verified account to claim a notification room and is weaker tenant isolation.
ALLOW_CLIENT_TENANT_CLAIM=false
